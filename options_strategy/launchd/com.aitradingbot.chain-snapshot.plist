<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Daily SPY option-chain snapshot (options_strategy/chain_snapshots.py).
  Weekdays at 16:30 local (Central), after options stop trading at 16:15 ET.
  A run missed while the Mac sleeps happens on wake; reruns for a quote date
  that's already saved are skipped.

  Install:   cp options_strategy/launchd/com.aitradingbot.chain-snapshot.plist ~/Library/LaunchAgents/
             launchctl load ~/Library/LaunchAgents/com.aitradingbot.chain-snapshot.plist
  Run now:   launchctl start com.aitradingbot.chain-snapshot
  Remove:    launchctl unload ~/Library/LaunchAgents/com.aitradingbot.chain-snapshot.plist
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.aitradingbot.chain-snapshot</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Users/bqh5026/miniconda3/bin/python3</string>
        <string>-m</string>
        <string>options_strategy.chain_snapshots</string>
        <string>--symbols</string>
        <string>SPY</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/Volumes/Samsung/ai-trading-bot</string>
    <key>StartCalendarInterval</key>
    <array>
        <dict><key>Weekday</key><integer>1</integer><key>Hour</key><integer>16</integer><key>Minute</key><integer>30</integer></dict>
        <dict><key>Weekday</key><integer>2</integer><key>Hour</key><integer>16</integer><key>Minute</key><integer>30</integer></dict>
        <dict><key>Weekday</key><integer>3</integer><key>Hour</key><integer>16</integer><key>Minute</key><integer>30</integer></dict>
        <dict><key>Weekday</key><integer>4</integer><key>Hour</key><integer>16</integer><key>Minute</key><integer>30</integer></dict>
        <dict><key>Weekday</key><integer>5</integer><key>Hour</key><integer>16</integer><key>Minute</key><integer>30</integer></dict>
    </array>
    <key>StandardOutPath</key>
    <string>/Volumes/Samsung/ai-trading-bot/options_strategy/chain_snapshots/snapshot.log</string>
    <key>StandardErrorPath</key>
    <string>/Volumes/Samsung/ai-trading-bot/options_strategy/chain_snapshots/snapshot.log</string>
</dict>
</plist>